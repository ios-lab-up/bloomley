---
interface Props {
  label: string;
  class?: string;
}
const { label, class: cls } = Astro.props;
---

<figure class:list={['phone', cls]} role="img" aria-label={label}>
  <div class="phone__screen" aria-hidden="true">
    <div class="phone__status">
      <span>9:41</span>
      <svg width="46" height="11" viewBox="0 0 46 11" fill="currentColor">
        <rect x="0" y="6" width="2.5" height="5" rx="1" />
        <rect x="4" y="4" width="2.5" height="7" rx="1" />
        <rect x="8" y="2" width="2.5" height="9" rx="1" />
        <rect x="12" y="0" width="2.5" height="11" rx="1" />
        <path d="M19 3.4a7.2 7.2 0 0 1 8.6 0l-1.2 1.5a5.3 5.3 0 0 0-6.2 0Zm2 2.5a3.9 3.9 0 0 1 4.6 0l-1.3 1.6a2 2 0 0 0-2 0Zm2.3 2.6.9 1.2h-1.8Z" />
        <rect x="31" y="1.5" width="12" height="8" rx="2.4" opacity=".4" />
        <rect x="32.6" y="3.1" width="8.8" height="4.8" rx="1.4" />
        <rect x="44" y="4" width="1.4" height="3" rx=".7" opacity=".4" />
      </svg>
    </div>
    <slot />
  </div>
</figure>
