---
const pillars = [
  {
    name: 'Physical',
    colour: 'var(--coral)',
    body: 'Movement, water, rest. The unglamorous things that decide how the rest of the day goes.',
    example: 'Walk for 10 minutes',
  },
  {
    name: 'Mental & emotional',
    colour: 'var(--sky)',
    body: 'Breathe, pause, unplug. Room to notice how you are doing before it becomes a problem.',
    example: 'Put the phone in another room for an hour',
  },
  {
    name: 'Social',
    colour: 'var(--sun)',
    body: 'Connect, thank, share. The part every habit tracker forgets, and the part that keeps you going.',
    example: 'Send one message you have been putting off',
  },
];
---

<section class="section pillars" id="pillars">
  <div class="wrap">
    <div class="pillars__head">
      <p class="eyebrow" data-reveal>Three pillars</p>
      <h2 data-reveal style="--index:1">Pick what you want to look after.</h2>
      <p class="prose pillars__lede" data-reveal style="--index:2">
        You choose one or more when you start, and you can change it any time.
        Every mission Bloom hands you comes from a pillar you actually picked.
      </p>
    </div>

    <dl class="pillars__list">
      {pillars.map((p, i) => (
        <div class="pillars__row" data-reveal style={`--index:${i}`}>
          <dt>
            <span class="pillars__dot" style={`background:${p.colour}`} aria-hidden="true"></span>
            {p.name}
          </dt>
          <dd class="prose">{p.body}</dd>
          <dd class="pillars__eg">
            <span class="vh">Example mission: </span>{p.example}
          </dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .pillars__head { max-width: 42rem; }
  .pillars__head h2 { margin-block: var(--s-3) var(--s-4); }
  .pillars__lede { max-width: 52ch; }

  .pillars__list { margin: var(--s-12) 0 0; }

  /* Rows with rules, echoing the app's own list. Not a three-card grid. */
  .pillars__row {
    display: grid;
    gap: var(--s-3) var(--s-8);
    align-items: baseline;
    padding-block: var(--s-6);
    border-top: 1px solid var(--line);
  }
  .pillars__row:last-child { border-bottom: 1px solid var(--line); }

  .pillars__row dt {
    display: flex;
    align-items: baseline;
    gap: var(--s-3);
    font-size: var(--fs-h3);
    font-weight: 900;
    letter-spacing: -0.02em;
    color: var(--ink);
    text-wrap: balance;
  }
  .pillars__row dd { margin: 0; }

  .pillars__dot {
    flex: 0 0 auto;
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
    translate: 0 -0.1em;
  }

  .pillars__eg {
    font-size: var(--fs-sm);
    font-weight: 800;
    color: var(--purple-deep);
    text-wrap: pretty;
  }
  .pillars__eg::before { content: '“'; }
  .pillars__eg::after { content: '”'; }

  @media (min-width: 881px) {
    .pillars__row {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.3fr) minmax(0, 0.8fr);
    }
  }
</style>
