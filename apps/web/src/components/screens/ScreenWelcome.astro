---
import { Image } from 'astro:assets';
import wave from '../../assets/bloom/bloom-wave.png';
---

<div class="scr scr--spread scr--center">
  <div class="scr__group" style="align-items:center;gap:27px;padding-top:43px">
    <div class="scr__halo scr__halo--lg">
      <Image src={wave} alt="" width={250} densities={[1, 2]} />
    </div>
    <div class="scr__group" style="gap:9px;align-items:center">
      <p class="scr__title scr__title--hero">Small actions.<br />Big change.</p>
      <p class="scr__sub" style="max-width:229px">Bloomley turns your wellbeing goals into one thing you can do today.</p>
    </div>
  </div>
  <div class="scr__stack">
    <div class="scr__btn scr__btn--primary">Get started</div>
    <div class="scr__btn scr__btn--ghost">I already have an account</div>
  </div>
</div>
