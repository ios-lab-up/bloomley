---
import { Image } from 'astro:assets';
import wave from '../../assets/bloom/bloom-wave.png';
---

<div class="scr scr--spread scr--center">
  <div class="scr__group" style="align-items:center;padding-top:14px">
    <Image src={wave} alt="" width={330} densities={[1, 2]} class="scr__bloom scr__bloom--lg" />
    <div class="scr__group" style="gap:8px">
      <p class="scr__title scr__title--hero">Small actions.<br />Big change.</p>
      <p class="scr__sub">Bloomley turns your wellbeing goals into one thing you can do today.</p>
    </div>
  </div>
  <div class="scr__stack">
    <div class="scr__btn scr__btn--primary">Get started</div>
    <div class="scr__btn scr__btn--ghost">I already have an account</div>
  </div>
</div>
