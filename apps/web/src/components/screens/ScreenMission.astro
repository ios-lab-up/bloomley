---
import { Image } from 'astro:assets';
import happy from '../../assets/bloom/bloom-happy.png';
---

<div class="scr scr--spread">
  <div class="scr__group" style="align-items:center;gap:24px">
    <div class="scr__progress">
      <i></i><i></i><i></i><i></i><i data-on></i>
    </div>
    <div class="scr__halo" style="margin-top:40px">
      <Image src={happy} alt="" width={183} densities={[1, 2]} />
    </div>
    <div class="scr__group" style="gap:9px;text-align:center;align-items:center">
      <p class="scr__title scr__title--hero">Walk for 10 minutes</p>
      <p class="scr__sub" style="max-width:237px">Head outside or pace around at home. No pace, no step goal. Just move.</p>
      <p class="scr__meta">Physical &middot; 10 min &middot; +10 XP</p>
    </div>
  </div>
  <div class="scr__stack">
    <div class="scr__btn scr__btn--primary">I'll do it now</div>
    <div class="scr__btn scr__btn--ghost">Later</div>
  </div>
</div>
