---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Pillars from '../components/Pillars.astro';
import EnergyAdapts from '../components/EnergyAdapts.astro';
import FlowShowcase from '../components/FlowShowcase.astro';
import Together from '../components/Together.astro';
import Faq from '../components/Faq.astro';
import Footer from '../components/Footer.astro';
---

<Base
  title="Bloomley — Small actions. Big change."
  description="Bloomley turns your wellbeing goals into one thing you can do today. One small mission a day, sized to the energy you actually have. Join the waitlist."
>
  <Nav />
  <main id="main">
    <Hero />
    <HowItWorks />
    <Pillars />
    <EnergyAdapts />
    <FlowShowcase />
    <Together />
    <Faq />
    <Footer />
  </main>
</Base>
