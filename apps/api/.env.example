APP_NAME=bloomley-api
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://bloomley:bloomley@localhost:5433/bloomley
CORS_ORIGINS=["*"]

# Clerk auth -- see docs/USERS_AUTH_CONTRACT.md
# Leave AUTH_DEV_BYPASS=true (default) to build against get_current_user
# without a real Clerk token: send `X-Debug-User-Id: <users.id>` instead.
AUTH_DEV_BYPASS=true
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
CLERK_JWKS_URL=
CLERK_BACKEND_API_URL=https://api.clerk.com
